# Local dev default: embedded Postgres started by `npm run db:local` (no install needed).
# Real Postgres (docker compose / brew / Neon): postgresql://resortos:resortos@localhost:5432/resortos
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable"
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Restaurant local time offset (no DST). Slot times are interpreted in this offset.
RESTAURANT_UTC_OFFSET=+07:00
# Used by `npm run db:seed` to create the read-only admin account
ADMIN_EMAIL=admin@resortos.test
ADMIN_PASSWORD=Admin12345!
# Test runs override this; production should keep the default 20
AUTH_RATE_LIMIT=20
