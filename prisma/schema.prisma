generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  /// The AI booking assistant's service account. May only book on a guest's behalf and look up one guest by email.
  AGENT
}

enum BookingSource {
  APP
  AGENT
}

enum Branch {
  BRANCH_1
  BRANCH_2
}

enum Sector {
  MAIN_HALL
  VIP_WING
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MenuType {
  SEASONAL_FINE_DINING
  A_LA_CARTE
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  /// Null for a guest account created by the assistant; sign-up sets it (claims the account).
  passwordHash        String?
  name                String
  phone               String?
  allergies           String[]
  role                Role          @default(USER)
  /// SHA-256 hex of AGENT_API_KEY. Set only on the AGENT account (the assistant authenticates with X-Agent-Key).
  apiKeyHash          String?       @unique
  createdAt           DateTime      @default(now()) @db.Timestamptz
  reservations        Reservation[]
  createdReservations Reservation[] @relation("CreatedBy")
}

/// A two-seat table (MAIN_HALL) or a private room (VIP_WING). Seeded, never edited by the app.
model DiningTable {
  id          String             @id // e.g. "B1-MH-07", "B2-VIP-2"
  branch      Branch
  sector      Sector
  seats       Int
  allocations ReservationTable[]

  @@index([branch, sector])
}

model Reservation {
  id              String             @id @default(cuid())
  /// Short human code shown to guests, e.g. "RSV-7K3Q9X"
  code            String             @unique
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  source          BookingSource      @default(APP)
  /// Who made the booking: the guest (app) or the assistant's service account.
  createdById     String?
  createdBy       User?              @relation("CreatedBy", fields: [createdById], references: [id])
  /// Retrying the same assistant confirmation returns the same booking instead of a second one.
  idempotencyKey  String?            @unique
  branch          Branch
  sector          Sector
  slotStart       DateTime           @db.Timestamptz
  slotEnd         DateTime           @db.Timestamptz
  partySize       Int
  specialRequests String?
  status          ReservationStatus  @default(CONFIRMED)
  /// Snapshot of assigned table/room IDs, kept after cancellation for the audit view.
  tableIds        String[]
  createdAt       DateTime           @default(now()) @db.Timestamptz
  updatedAt       DateTime           @updatedAt @db.Timestamptz
  cancelledAt     DateTime?          @db.Timestamptz
  allocations     ReservationTable[]

  @@index([userId])
  @@index([branch, slotStart])
  @@index([status])
  @@index([source])
}

/// Live table locks. Rows are deleted on cancel/reschedule, which frees the table.
/// The unique (tableId, slotStart) constraint makes double-booking impossible.
model ReservationTable {
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tableId       String
  table         DiningTable @relation(fields: [tableId], references: [id])
  slotStart     DateTime    @db.Timestamptz

  @@id([reservationId, tableId])
  @@unique([tableId, slotStart])
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  type        MenuType
  priceCents  Int
  allergens   String[]
  chefPick    Boolean  @default(false)
}

/// Append-only. UPDATE/DELETE are blocked by a DB trigger (see migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  timestamp  DateTime @default(now()) @db.Timestamptz
  actorId    String?
  action     String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  @@index([action, timestamp])
}
