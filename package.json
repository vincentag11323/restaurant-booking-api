{
  "name": "resortos-booking-api",
  "version": "1.0.0",
  "description": "ResortOS restaurant booking API (Express + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:e2e && npm run test:jest",
    "db:local": "pglite-server --db=./.pglite --port=5432 --max-connections=10",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:jest": "jest --coverage",
    "db-test": "tsx scripts/dbTest.ts",
    "start:test": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable PORT=4400 CORS_ORIGIN=http://localhost:5190 AUTH_RATE_LIMIT=100000 ERROR_LOG_PATH=logs/errors-test.log APP_LOG_PATH=logs/app-test.log SESSION_TTL=8s tsx src/index.ts",
    "test:pg": "test -n \"$TEST_DATABASE_URL\" || (echo \"Set TEST_DATABASE_URL to an empty PostgreSQL database\" && exit 1); npx playwright test && npx jest"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
